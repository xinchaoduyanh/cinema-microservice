{
  "name": "api-gateway",
  "private": true,
  "version": "1.0.0",
  "description": "Cinema Management API Gateway",
  "license": "MIT",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "pnpm --dir ../.. exec tsc -p apps/api-gateway/tsconfig.app.json",
    "start": "pnpm --dir ../.. exec nest start api-gateway",
    "start:dev": "pnpm --dir ../.. exec nest start api-gateway --watch",
    "start:debug": "pnpm --dir ../.. exec nest start api-gateway --debug --watch",
    "start:prod": "node ../../dist/apps/api-gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.6.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
